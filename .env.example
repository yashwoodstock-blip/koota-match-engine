# Database Connection (Asyncpg Postgres for production / Supabase, or SQLite for local dev)
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@db.your-project.supabase.co:5432/postgres

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Hugging Face Serverless Inference API (Free tier)
HF_API_TOKEN=hf_your_free_token_here
HF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_NLI_MODEL=facebook/bart-large-mnli

# LLM-as-a-Judge Providers (Zero-Cost Free Tiers)
# 1. Groq (Free Tier: 30 requests/min, ~1000 req/day)
GROQ_API_KEY=gsk_your_groq_free_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. OpenRouter (Free Models: meta-llama/llama-3.3-70b-instruct:free, google/gemini-2.0-flash-lite:free)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_free_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 3. Google Gemini (Free Tier: 15 RPM)
GEMINI_API_KEY=AIzaSy_your_gemini_free_key_here
GEMINI_MODEL=gemini-2.0-flash

# App Configuration
APP_ENV=development
RENDER_EXTERNAL_URL=https://your-service.onrender.com
